# Скопируйте в .env (это делает scripts/setup.sh) и при необходимости поправьте.

# Состояние платформы: история, пользователи, результаты генераций
DATA_PATH=./data

# Скачанные модели (десятки гигабайт — лучше быстрый SSD). Отдельный каталог:
# модели не теряются при пересборке образа и могут лежать на другом диске
MODELS_PATH=./models

# Адрес и порт веб-интерфейса
BIND_ADDR=0.0.0.0
PORT=7860

# Пользователей здесь нет: при первом открытии интерфейс предложит создать администратора

# Числовые GID групп render и video хоста (setup.sh подставит сам)
RENDER_GID=
VIDEO_GID=

# Токен Hugging Face — только для закрытых (gated) моделей, для каталога по умолчанию не нужен
HF_TOKEN=

# За HTTPS-прокси: COOKIE_SECURE=true, TRUST_PROXY=true
COOKIE_SECURE=false
TRUST_PROXY=false

# Версия stable-diffusion.cpp (тег или коммит), на которой проверена платформа
SD_CPP_REF=88411ef
