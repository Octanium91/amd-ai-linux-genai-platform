# Copied to .env by scripts/setup.sh; adjust if needed.

# Platform state: users, job history, logs, uploaded images
DATA_PATH=./data

# Downloaded models (tens of gigabytes, a fast SSD is best). A separate directory:
# models survive image rebuilds and may live on another disk
MODELS_PATH=./models

# Generated videos and images, also separate so they survive updates and can live anywhere
OUTPUT_PATH=./output

# Web UI address and port
BIND_ADDR=0.0.0.0
PORT=7860

# No users here: on first open the web UI offers to create the administrator

# Host user the container runs as, so data/models/output stay owned by you (filled in by setup.sh)
PUID=
PGID=

# Host time zone for file names and dates (filled in by setup.sh). Node ignores the mounted
# /etc/localtime because in the image it is a link named Etc/UTC, so the zone is passed by name.
TZ=

# Numeric GIDs of the host render and video groups (filled in by setup.sh)
RENDER_GID=
VIDEO_GID=

# Hugging Face token, only needed for gated models (not for the default catalog)
HF_TOKEN=

# Behind an HTTPS proxy: COOKIE_SECURE=true, TRUST_PROXY=true
COOKIE_SECURE=false
TRUST_PROXY=false

# stable-diffusion.cpp version (tag or commit) the platform was tested with
SD_CPP_REF=88411ef
