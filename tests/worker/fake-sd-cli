#!/usr/bin/env bash
# A stand-in for sd-cli: prints progress the way sd-cli does and writes small results with ffmpeg.
# Images of a batch (-b N) are sampled one after another and decoded together, as in sd-cli.
[ "${1:-}" = "--version" ] && { echo "stable-diffusion.cpp version fake"; exit 0; }
out=""; frames=1; mode=img_gen; batch=1
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out="$2"; shift;;
    --video-frames) frames="$2"; shift;;
    -M) mode="$2"; shift;;
    -b) batch="$2"; shift;;
  esac
  shift
done
steps=${FAKE_STEPS:-6}
sample() {
  for i in $(seq 1 "$steps"); do
    printf '\r  |==========>          | %d/%d - 0.50s/it' "$i" "$steps"
    sleep "${FAKE_SLEEP:-0.3}"
  done
  echo
  echo "sampling completed"
}
if [ "$mode" = vid_gen ]; then
  echo "generate_video 64x64x$frames"
  sample
  echo "decode_first_stage completed"
  ffmpeg -loglevel error -y -f lavfi -i "testsrc=size=64x64:rate=8" -frames:v "$frames" -c:v mjpeg "$out" || exit 3
else
  for b in $(seq 1 "$batch"); do
    echo "generating image: $b/$batch"
    sample
  done
  echo "generating $batch latent images completed"
  sleep 0.5
  echo "decode_first_stage completed"
  for b in $(seq 1 "$batch"); do
    f="$out"; [ "$batch" -gt 1 ] && f="${out%.png}_$b.png"
    ffmpeg -loglevel error -y -f lavfi -i "testsrc=size=64x64:rate=1" -frames:v 1 "$f" || exit 3
    echo "save result image $((b - 1)) to '$f'"
  done
fi
